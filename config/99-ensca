#!/bin/bash
LOCK=/run/ensca-iptables-init.lock
[ -f "$LOCK" ] && exit 0

echo 0 > /proc/sys/net/ipv4/conf/enp10s0u1/proxy_arp

# ── iptables ──────────────────────────────────────────────────────────────────
iptables -F FORWARD
iptables -F INPUT
iptables -t nat -F
iptables -t mangle -F FORWARD

iptables -t nat -A POSTROUTING -o enp2s0 -j MASQUERADE
iptables -t nat -A PREROUTING -i enp10s0u1 -p tcp --dport 80 -j REDIRECT --to-port 8080
# Redirect unauthenticated DNS to dnsmasq; grant_access inserts per-IP DNAT above this
iptables -t nat -A PREROUTING -i enp10s0u1 -p udp --dport 53 -j REDIRECT --to-port 53
iptables -A FORWARD -i enp2s0 -o enp10s0u1 -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -A INPUT -i enp10s0u1 -p tcp --dport 8080 -j ACCEPT
iptables -A INPUT -i enp10s0u1 -p udp --dport 53 -j ACCEPT
iptables -A FORWARD -i enp10s0u1 -j DROP

# ── tc rate limiting on enp2s0 (WAN egress toward internet) ───────────────────
# HTB root qdisc — default class passes traffic unthrottled
tc qdisc del dev enp2s0 root 2>/dev/null
tc qdisc add dev enp2s0 root handle 1: htb default 99

# Class 99: default (unclassified / unauthenticated) — 1 Mbps ceiling
tc class add dev enp2s0 parent 1: classid 1:99 htb rate 1mbit ceil 1mbit

# Class 10: basic — 5 Mbps
tc class add dev enp2s0 parent 1: classid 1:10 htb rate 5mbit ceil 5mbit burst 15k

# Class 20: staff — 10 Mbps
tc class add dev enp2s0 parent 1: classid 1:20 htb rate 10mbit ceil 10mbit burst 30k

# Class 30: vip — unlimited (rate 1gbit = effectively uncapped on this link)
tc class add dev enp2s0 parent 1: classid 1:30 htb rate 1000mbit ceil 1000mbit

# fwmark → tc class filter (marks set by iptables mangle in grant_access)
tc filter add dev enp2s0 parent 1: protocol ip handle 10 fw classid 1:10
tc filter add dev enp2s0 parent 1: protocol ip handle 20 fw classid 1:20
tc filter add dev enp2s0 parent 1: protocol ip handle 30 fw classid 1:30

touch "$LOCK"
